' Estilo común de los diagramas de NovaSol Salud
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam roundCorner 10
skinparam ActorBorderColor #0f766e
skinparam ActorBackgroundColor #ccfbf1
skinparam UsecaseBorderColor #0f766e
skinparam UsecaseBackgroundColor #f0fdfa
skinparam PackageBorderColor #64748b
skinparam PackageBackgroundColor #f8fafc
skinparam RectangleBorderColor #64748b
skinparam NoteBackgroundColor #fffbeb
skinparam NoteBorderColor #d97706
skinparam ParticipantBorderColor #0f766e
skinparam ParticipantBackgroundColor #f0fdfa
skinparam SequenceLifeLineBorderColor #94a3b8
skinparam SequenceGroupBorderColor #64748b
skinparam BoundaryBorderColor #0f766e
skinparam BoundaryBackgroundColor #f0fdfa
skinparam ControlBorderColor #4f46e5
skinparam ControlBackgroundColor #eef2ff
skinparam EntityBorderColor #b45309
skinparam EntityBackgroundColor #fffbeb
skinparam ClassBorderColor #0f766e
skinparam ClassBackgroundColor #f8fafc
skinparam ClassHeaderBackgroundColor #ccfbf1
skinparam ActivityBorderColor #0f766e
skinparam ActivityBackgroundColor #f0fdfa
skinparam SwimlaneTitleFontStyle bold
skinparam StateBorderColor #0f766e
skinparam StateBackgroundColor #f0fdfa
skinparam NodeBorderColor #0f766e
skinparam NodeBackgroundColor #f0fdfa
skinparam DatabaseBorderColor #b45309
skinparam DatabaseBackgroundColor #fffbeb
skinparam ComponentBorderColor #4f46e5
skinparam ComponentBackgroundColor #eef2ff
