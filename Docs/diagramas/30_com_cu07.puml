@startuml 30_com_cu07
!include estilo.iuml
title Diagrama de comunicación · CU7 Gestionar pacientes
left to right direction
actor "Recepcionista" as A
boundary "IU_Pacientes" as IU
control "CtrlPaciente" as C
entity "Paciente" as P
entity "HistoriaClinica" as H
entity "Cita" as CI
A --> IU : "1: buscar(CI, nombre)\n4: registrar(datos)\n8: verHistorial()"
IU --> C : "2: buscar()\n5: guardar()\n9: historial()"
C --> P : "3: listar(filtros)\n6: existeCI()\n7: crear(código PAC-####)"
C --> H : "7.1: crear(número HC)"
C --> CI : "10: delPaciente()"
@enduml
