# Copie este archivo como .env y complete los datos de su base PostgreSQL
APP_ENV=local
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?sslmode=require
# Ejemplo local (XAMPP/Laragon): postgresql://postgres:postgres@localhost:5432/headsalud?sslmode=disable
DATABASE_URL=postgresql://headsalud_app.PROYECTO:CLAVE@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
